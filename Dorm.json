      "parameters": {
        "jsCode": "const now = new Date();\nconst day = now.getDay(); \nconst hour = now.getHours();\n\nlet isOpen = false;\n\n// Monday 10:00 to Tuesday 12:00\nif ((day === 1 && hour >= 10) || (day === 2 && hour < 12)) {\n    isOpen = true;\n}\n\n// Wednesday 10:00 to Thursday 12:00\nif ((day === 3 && hour >= 10) || (day === 4 && hour < 12)) {\n    isOpen = true;\n}\n\n// Generate a random delay between 0 and 240 seconds (4 minutes)\nconst randomDelay = Math.floor(Math.random() * 241);\n\nreturn [{ json: { isOpen, randomDelay } }];"
      },
