    {
      "parameters": {
        "jsCode": "// Persistent dedup across runs using n8n static data\nconst data = this.getWorkflowStaticData('global');\nif (!data.seen) data.seen = [];\n\n// Optional: keep only last 500 entries to prevent unbounded growth\nconst MAX = 500;\n\nconst out = [];\nfor (const item of items) {\n  const link = item.json.link;\n  if (!link) continue;\n\n  const key = String(link).trim();\n  if (!data.seen.includes(key)) {\n    data.seen.push(key);\n    if (data.seen.length > MAX) {\n      data.seen = data.seen.slice(data.seen.length - MAX);\n    }\n    out.push(item);\n  }\n}\n\nreturn out;"
      },
