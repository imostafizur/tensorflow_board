{
  "name": "Dorm Monitor Random Loop",
  "nodes": [
    {
      "parameters": {},
      "id": "start",
      "name": "Manual Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-1200, 0]
    },
    {
      "parameters": {
        "jsCode": "function berlinNowParts(date = new Date()) {\n  const parts = new Intl.DateTimeFormat('en-GB', {\n    timeZone: 'Europe/Berlin',\n    weekday: 'short',\n    hour: '2-digit',\n    minute: '2-digit',\n    hour12: false,\n  }).formatToParts(date);\n\n  const obj = {};\n  for (const p of parts) obj[p.type] = p.value;\n\n  const weekdayMap = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 0 };\n\n  return {\n    day: weekdayMap[obj.weekday],\n    hour: parseInt(obj.hour, 10),\n    minute: parseInt(obj.minute, 10),\n  };\n}\n\nconst { day, hour, minute } = berlinNowParts(new Date());\n\nlet isOpen = false;\n\nif ((day === 1 && hour >= 10) || (day === 2 && hour < 12)) isOpen = true;\nif ((day === 3 && hour >= 10) || (day === 4 && hour < 12)) isOpen = true;\n\nreturn [{ json: { isOpen } }];"
      },
      "id": "window",
      "name": "Check Window (Berlin)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1000, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.isOpen}}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "ifWindow",
      "name": "Window Open?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-800, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.stwdo.de/wohnen/aktuelle-wohnangebote"
      },
      "id": "http",
      "name": "Fetch Listings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [-600, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = JSON.stringify($json);\nconst lower = body.toLowerCase();\n\nconst blocked = lower.includes('captcha') || lower.includes('cloudflare') || lower.includes('access denied');\n\nreturn [{ json: { blocked, html: $json.data || $json.body || '' } }];"
      },
      "id": "checkBlock",
      "name": "Check Blocked",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.blocked}}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "ifBlocked",
      "name": "Blocked?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "⚠️ Dorm Monitor Blocked / Captcha Detected"
      },
      "id": "alertBlocked",
      "name": "Telegram Block Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [0, -100]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": ".residential-offer__title",
              "returnValue": "html"
            },
            {
              "key": "link",
              "cssSelector": ".residential-offer__link a",
              "returnValue": "attribute",
              "attribute": "href"
            }
          ]
        }
      },
      "id": "extract",
      "name": "Extract Rooms",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1,
      "position": [0, 100]
    },
    {
      "parameters": {
        "jsCode": "const data = this.getWorkflowStaticData('global');\nif (!data.seen) data.seen = [];\n\nconst out = [];\nfor (const item of items) {\n  const link = item.json.link;\n  if (!link) continue;\n  if (!data.seen.includes(link)) {\n    data.seen.push(link);\n    out.push(item);\n  }\n}\nreturn out;"
      },
      "id": "dedup",
      "name": "Only New Rooms",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 100]
    },
    {
      "parameters": {
        "chatId": "YOUR_CHAT_ID",
        "text": "🚨 New Dorm Offer!\n\n{{$json.title}}\n{{$json.link}}"
      },
      "id": "alert",
      "name": "Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [400, 100]
    },
    {
      "parameters": {
        "jsCode": "const randomSeconds = Math.floor(Math.random() * (300 - 60 + 1)) + 60;\nreturn [{ json: { randomSeconds } }];"
      },
      "id": "random",
      "name": "Random 1-5 Min",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 0]
    },
    {
      "parameters": {
        "amount": "={{$json.randomSeconds}}",
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [800, 0]
    }
  ],
  "connections": {
    "Manual Start": {
      "main": [[{ "node": "Check Window (Berlin)", "type": "main", "index": 0 }]]
    },
    "Check Window (Berlin)": {
      "main": [[{ "node": "Window Open?", "type": "main", "index": 0 }]]
    },
    "Window Open?": {
      "main": [
        [{ "node": "Fetch Listings", "type": "main", "index": 0 }],
        [{ "node": "Random 1-5 Min", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Listings": {
      "main": [[{ "node": "Check Blocked", "type": "main", "index": 0 }]]
    },
    "Check Blocked": {
      "main": [[{ "node": "Blocked?", "type": "main", "index": 0 }]]
    },
    "Blocked?": {
      "main": [
        [{ "node": "Extract Rooms", "type": "main", "index": 0 }],
        [{ "node": "Telegram Block Alert", "type": "main", "index": 0 }]
      ]
    },
    "Extract Rooms": {
      "main": [[{ "node": "Only New Rooms", "type": "main", "index": 0 }]]
    },
    "Only New Rooms": {
      "main": [[{ "node": "Telegram Alert", "type": "main", "index": 0 }]]
    },
    "Telegram Alert": {
      "main": [[{ "node": "Random 1-5 Min", "type": "main", "index": 0 }]]
    },
    "Telegram Block Alert": {
      "main": [[{ "node": "Random 1-5 Min", "type": "main", "index": 0 }]]
    },
    "Random 1-5 Min": {
      "main": [[{ "node": "Wait", "type": "main", "index": 0 }]]
    },
    "Wait": {
      "main": [[{ "node": "Check Window (Berlin)", "type": "main", "index": 0 }]]
    }
  },
  "active": false
}
