{
  "name": "Dorm_Bot",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutes": 10
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const day = new Date().getDay();\n// STWDO frequently publishes updates on Mondays (1) and Wednesdays (3)\nconst isPublishingDay = (day === 1 || day === 3);\n// Generate a random delay between 5 to 35 seconds to avoid rate limiting\nconst delaySeconds = Math.floor(Math.random() * 30) + 5;\nreturn [{ json: { isPublishingDay, delaySeconds } }];"
      },
      "id": "2",
      "name": "Publish Window & Delay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "amount": "={{ $json.delaySeconds }}",
        "unit": "seconds"
      },
      "id": "3",
      "name": "Wait (Anti-Bot)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [400, 0]
    },
    {
      "parameters": {
        "url": "https://www.stwdo.de/wohnen/aktuelle-wohnangebote",
        "options": {}
      },
      "id": "4",
      "name": "Fetch STWDO Listings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [600, 0]
    },
    {
      "parameters": {
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": "h2", 
              "returnValue": "text"
            },
            {
              "key": "link",
              "cssSelector": "a", 
              "returnValue": "attribute",
              "attribute": "href"
            },
            {
              "key": "price",
              "cssSelector": ".price", 
              "returnValue": "text"
            }
          ]
        },
        "options": {}
      },
      "id": "5",
      "name": "Extract Rooms",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 1,
      "position": [800, 0]
    },
    {
      "parameters": {
        "operation": "removeDuplicates",
        "compare": "allFields"
      },
      "id": "6",
      "name": "Only New Rooms",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [1000, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1a2b3",
              "leftValue": "={{ $json.price }}",
              "rightValue": "€",
              "operator": {
                "type": "string",
                "operation": "contains",
                "name": "filter",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9",
      "name": "Is Real Offer?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "chatId": "1520384878",
        "text": "=New Dorm Available!\nTitle: {{ $json.title }}\nPrice: {{ $json.price }}\nLink: https://www.stwdo.de{{ $json.link }}",
        "additionalFields": {}
      },
      "id": "7",
      "name": "Telegram Alert 1",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1400, -100],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "6231942759",
        "text": "=New Dorm Available!\nTitle: {{ $json.title }}\nPrice: {{ $json.price }}\nLink: https://www.stwdo.de{{ $json.link }}",
        "additionalFields": {}
      },
      "id": "8",
      "name": "Telegram Alert 2",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1400, 100],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Publish Window & Delay",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish Window & Delay": {
      "main": [
        [
          {
            "node": "Wait (Anti-Bot)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait (Anti-Bot)": {
      "main": [
        [
          {
            "node": "Fetch STWDO Listings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch STWDO Listings": {
      "main": [
        [
          {
            "node": "Extract Rooms",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Rooms": {
      "main": [
        [
          {
            "node": "Only New Rooms",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only New Rooms": {
      "main": [
        [
          {
            "node": "Is Real Offer?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Real Offer?": {
      "main": [
        [
          {
            "node": "Telegram Alert 1",
            "type": "main",
            "index": 0
          },
          {
            "node": "Telegram Alert 2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
